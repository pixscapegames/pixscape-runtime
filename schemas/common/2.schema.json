{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixscape.games/schemas/pixscape/common/2.schema.json",
  "title": "Shared Pixscape value structures",
  "$defs": {
    "intArray": {
      "type": "object",
      "properties": {
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "size"
      ],
      "description": "LibGDX IntArray. Items may be omitted or null at SceneLoader boundary; only the first size entries are active when present."
    },
    "byteArray": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "size"
      ],
      "description": "LibGDX ByteArray. Items may be omitted for zero-filled storage; only the first size entries are active."
    },
    "propertyValue": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "STRING",
            "BOOLEAN",
            "INTEGER",
            "FLOAT",
            "COLOR",
            "OBJECT",
            "CLASS",
            "LIST",
            "ENUM",
            "IMPORTED"
          ],
          "default": "STRING"
        },
        "stringValue": {
          "type": "string",
          "default": ""
        },
        "booleanValue": {
          "type": "boolean",
          "default": false
        },
        "integerValue": {
          "type": "integer",
          "default": 0
        },
        "floatValue": {
          "type": "number",
          "default": 0
        },
        "className": {
          "type": "string",
          "default": ""
        },
        "classProperties": {
          "$ref": "#/$defs/propertySet",
          "default": {
            "values": {}
          }
        },
        "listValues": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/propertyValue"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "enumDefinition": {
          "anyOf": [
            {
              "$ref": "#/$defs/enumDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "importedType": {
          "type": "string"
        },
        "importedCustomType": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "LIST"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "listValues"
            ],
            "properties": {
              "listValues": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/propertyValue"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ENUM"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enumDefinition"
            ],
            "properties": {
              "enumDefinition": {
                "$ref": "#/$defs/enumDefinition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CLASS"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "className"
            ],
            "properties": {
              "className": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "OBJECT"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "integerValue"
            ],
            "properties": {
              "integerValue": {
                "anyOf": [
                  {
                    "const": -1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "IMPORTED"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "importedType",
              "stringValue"
            ],
            "properties": {
              "importedType": {
                "type": "string",
                "pattern": "\\S"
              },
              "stringValue": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "enumDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "storageType": {
          "enum": [
            "STRING",
            "INTEGER"
          ],
          "default": "STRING"
        },
        "flags": {
          "type": "boolean",
          "default": false
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": [
        "name"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "flags": {
                "const": true
              }
            },
            "required": [
              "flags"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "maxItems": 31,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^,]+$"
                }
              }
            }
          }
        }
      ]
    },
    "propertySet": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/propertyValue"
          },
          "default": {}
        }
      }
    },
    "physicsGeometry": {
      "type": "object",
      "properties": {
        "shapeType": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "default": 0
        },
        "offsetX": {
          "type": "number",
          "default": 0
        },
        "offsetY": {
          "type": "number",
          "default": 0
        },
        "angleDegrees": {
          "type": "number",
          "default": 0
        },
        "radius": {
          "type": "number",
          "default": 0.5
        },
        "halfWidth": {
          "type": "number",
          "default": 0.5
        },
        "halfHeight": {
          "type": "number",
          "default": 0.5
        },
        "polygonVertices": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": []
        },
        "polygonVertexCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "physicsShape": {
      "type": "object",
      "properties": {
        "physicsShapeId": {
          "type": "integer",
          "default": 0
        },
        "spatialBlockId": {
          "type": "integer",
          "default": 0
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/physicsGeometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "density": {
          "type": "number",
          "default": 1
        },
        "friction": {
          "type": "number",
          "default": 0.2
        },
        "restitution": {
          "type": "number",
          "default": 0
        },
        "sensor": {
          "type": "boolean",
          "default": false
        },
        "categoryBits": {
          "type": "integer",
          "default": 1
        },
        "maskBits": {
          "type": "integer",
          "default": -1
        },
        "groupIndex": {
          "type": "integer",
          "default": 0
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "spatialFootprint"
            ]
          },
          {
            "required": [
              "useSpatialFootprint"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "spatialBlockId": {
                "minimum": 1
              }
            },
            "required": [
              "spatialBlockId"
            ]
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "geometry": {
                "$ref": "#/$defs/physicsGeometry"
              }
            },
            "required": [
              "geometry"
            ]
          }
        }
      ]
    },
    "spatialShape": {
      "type": "object",
      "properties": {
        "shapeType": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "default": 0
        },
        "polyVerts": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": []
        },
        "polyCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "halfW": {
          "type": "number",
          "default": 0.5
        },
        "halfH": {
          "type": "number",
          "default": 0.5
        },
        "radius": {
          "type": "number",
          "default": 0.5
        },
        "offsetX": {
          "type": "number",
          "default": 0
        },
        "offsetY": {
          "type": "number",
          "default": 0
        },
        "angleDeg": {
          "type": "number",
          "default": 0
        },
        "collisionEnabled": {
          "type": "boolean",
          "default": false
        },
        "actorOccluder": {
          "type": "boolean",
          "default": false
        },
        "lightOccluder": {
          "type": "boolean",
          "default": false
        },
        "particleOccluder": {
          "type": "boolean",
          "default": false
        },
        "altitude": {
          "type": "number",
          "default": 0
        },
        "height": {
          "type": "number",
          "default": 0
        }
      }
    },
    "spatialBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "default": 0
        },
        "structureId": {
          "type": "integer",
          "default": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "width": {
          "type": "number",
          "default": 0
        },
        "depth": {
          "type": "number",
          "default": 0
        },
        "altitude": {
          "type": "number",
          "default": 0
        },
        "height": {
          "type": "number",
          "default": 128
        },
        "actorOccluder": {
          "type": "boolean",
          "default": true
        },
        "lightOccluder": {
          "type": "boolean",
          "default": false
        },
        "shadowCaster": {
          "type": "boolean",
          "default": false
        },
        "particleOccluder": {
          "type": "boolean",
          "default": false
        },
        "linkedTileRefsAuthored": {
          "type": "boolean",
          "default": false
        },
        "linkedTileRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gx": {
                "type": "integer"
              },
              "gy": {
                "type": "integer"
              },
              "tileAssetId": {
                "type": "integer"
              }
            }
          },
          "default": []
        }
      }
    },
    "localLightingSurface": {
      "type": "object",
      "properties": {
        "xyz": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "uv": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "receiveLight": {
          "type": "boolean",
          "default": true
        },
        "shadowCaster": {
          "type": "boolean",
          "default": false
        },
        "twoSided": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "xyz",
        "uv",
        "normals",
        "triangles"
      ]
    },
    "actorRectangle": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        }
      },
      "description": "Optional image-local normalized zone with finite, strictly positive configured dimensions, clipped against the native visual triangles after deformation. Missing settings mean the full image. Only the resulting geometry may be empty after clipping or deformation. pivotX/Y are projected pixel offsets from the resolved footprint, independent of image TRS."
    },
    "actorRectangles": {
      "type": "object",
      "properties": {
        "staticRectangle": {
          "anyOf": [
            {
              "$ref": "#/$defs/actorRectangle"
            },
            {
              "type": "null"
            }
          ]
        },
        "clips": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/actorRectangle"
            }
          }
        }
      }
    }
  }
}
