{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixscape.games/schemas/pixscape/game-object/3.schema.json",
  "title": "Pixscape Game Object definition 3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "rootSourceEntityId": {
      "type": "integer",
      "minimum": 0
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceEntityId": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "parentSourceEntityId": {
            "type": "integer",
            "default": -1
          },
          "transform": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "default": 0
              },
              "y": {
                "type": "number",
                "default": 0
              },
              "rotationRad": {
                "type": "number",
                "default": 0
              },
              "scaleX": {
                "type": "number",
                "default": 0
              },
              "scaleY": {
                "type": "number",
                "default": 0
              },
              "originX": {
                "type": "number",
                "default": 0
              },
              "originY": {
                "type": "number",
                "default": 0
              }
            }
          },
          "entityIndex": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "zIndex": {
                    "type": "integer",
                    "default": 0
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "physicsShapes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "localShapeId": {
                  "type": "integer",
                  "minimum": 1
                },
                "geometry": {
                  "$ref": "https://pixscape.games/schemas/pixscape/common/1.schema.json#/$defs/physicsGeometry"
                },
                "density": {
                  "type": "number"
                },
                "friction": {
                  "type": "number"
                },
                "restitution": {
                  "type": "number"
                },
                "sensor": {
                  "type": "boolean"
                },
                "categoryBits": {
                  "type": "integer"
                },
                "maskBits": {
                  "type": "integer"
                },
                "groupIndex": {
                  "type": "integer"
                },
                "enabled": {
                  "type": "boolean"
                },
                "spatialFootprint": {
                  "type": "boolean"
                }
              }
            },
            "default": []
          },
          "meta": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "identity": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "tags": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "customProperties": {
            "anyOf": [
              {
                "$ref": "https://pixscape.games/schemas/pixscape/common/1.schema.json#/$defs/propertySet"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "visibility": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "visible": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "boundsFlags": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "hasAabb": {
                    "type": "boolean"
                  },
                  "hasObb": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "dimensions": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "quadDeform": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "blX": {
                    "type": "number",
                    "default": 0
                  },
                  "blY": {
                    "type": "number",
                    "default": 0
                  },
                  "brX": {
                    "type": "number",
                    "default": 0
                  },
                  "brY": {
                    "type": "number",
                    "default": 0
                  },
                  "trX": {
                    "type": "number",
                    "default": 0
                  },
                  "trY": {
                    "type": "number",
                    "default": 0
                  },
                  "tlX": {
                    "type": "number",
                    "default": 0
                  },
                  "tlY": {
                    "type": "number",
                    "default": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "renderMaterial": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "shaderIdx": {
                    "type": "integer",
                    "default": 0
                  },
                  "blendModeId": {
                    "type": "integer",
                    "default": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "assetRef": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "assetId": {
                    "type": "integer"
                  },
                  "atlasTag": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "tint": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rgba": {
                    "type": "integer"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "animation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "animationAssetIds": {
                    "anyOf": [
                      {
                        "$ref": "https://pixscape.games/schemas/pixscape/common/1.schema.json#/$defs/intArray"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": {
                      "size": 0
                    }
                  },
                  "currentClip": {
                    "type": "string",
                    "default": ""
                  },
                  "fps": {
                    "type": "number",
                    "default": 12
                  },
                  "stateTime": {
                    "type": "number",
                    "default": 0
                  },
                  "playing": {
                    "type": "boolean",
                    "default": true
                  },
                  "loop": {
                    "type": "boolean",
                    "default": true
                  },
                  "frame": {
                    "type": "integer",
                    "default": -1
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "shaderParams": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "floats": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "repeat": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "repeatX": {
                    "type": "boolean",
                    "default": false
                  },
                  "repeatY": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "pointLight": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "r": {
                    "type": "number",
                    "default": 1
                  },
                  "g": {
                    "type": "number",
                    "default": 1
                  },
                  "b": {
                    "type": "number",
                    "default": 1
                  },
                  "intensity": {
                    "type": "number",
                    "default": 1
                  },
                  "radius": {
                    "type": "number",
                    "default": 200
                  },
                  "falloff": {
                    "type": "number",
                    "default": 1.5
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "coneLight": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "r": {
                    "type": "number",
                    "default": 1
                  },
                  "g": {
                    "type": "number",
                    "default": 1
                  },
                  "b": {
                    "type": "number",
                    "default": 1
                  },
                  "intensity": {
                    "type": "number",
                    "default": 1
                  },
                  "radius": {
                    "type": "number",
                    "default": 200
                  },
                  "falloff": {
                    "type": "number",
                    "default": 1.5
                  },
                  "coneAngleDeg": {
                    "type": "number",
                    "default": 45
                  },
                  "rotationDeg": {
                    "type": "number",
                    "default": 0
                  },
                  "softness": {
                    "type": "number",
                    "default": 0.1
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "spatialHeight": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "altitude": {
                    "type": "number",
                    "default": 0
                  },
                  "height": {
                    "type": "number",
                    "default": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "physicsBody": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "integer",
                    "default": 2
                  },
                  "fixedRotation": {
                    "type": "boolean",
                    "default": false
                  },
                  "bullet": {
                    "type": "boolean",
                    "default": false
                  },
                  "allowSleep": {
                    "type": "boolean",
                    "default": true
                  },
                  "awake": {
                    "type": "boolean",
                    "default": true
                  },
                  "gravityScale": {
                    "type": "number",
                    "default": 1
                  },
                  "linearDamping": {
                    "type": "number",
                    "default": 0
                  },
                  "angularDamping": {
                    "type": "number",
                    "default": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "gameObject": {
            "anyOf": [
              {
                "type": "object",
                "properties": {}
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "transform"
        ]
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jointLocalId": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "bodyALocalEntityId": {
            "type": "integer",
            "minimum": 0
          },
          "bodyBLocalEntityId": {
            "type": "integer",
            "minimum": 0
          },
          "collideConnected": {
            "type": "boolean"
          },
          "anchorAx": {
            "type": "number"
          },
          "anchorAy": {
            "type": "number"
          },
          "anchorBx": {
            "type": "number"
          },
          "anchorBy": {
            "type": "number"
          },
          "distance": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lengthM": {
                    "type": "number"
                  },
                  "frequencyHz": {
                    "type": "number"
                  },
                  "dampingRatio": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "revolute": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lowerAngleRad": {
                    "type": "number"
                  },
                  "upperAngleRad": {
                    "type": "number"
                  },
                  "motorSpeedRad": {
                    "type": "number"
                  },
                  "maxMotorTorque": {
                    "type": "number"
                  },
                  "enableLimit": {
                    "type": "boolean"
                  },
                  "enableMotor": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "prismatic": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "axisX": {
                    "type": "number"
                  },
                  "axisY": {
                    "type": "number"
                  },
                  "lowerTranslationM": {
                    "type": "number"
                  },
                  "upperTranslationM": {
                    "type": "number"
                  },
                  "motorSpeedMps": {
                    "type": "number"
                  },
                  "maxMotorForce": {
                    "type": "number"
                  },
                  "enableLimit": {
                    "type": "boolean"
                  },
                  "enableMotor": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "pulley": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "groundAnchorALocalX": {
                    "type": "number"
                  },
                  "groundAnchorALocalY": {
                    "type": "number"
                  },
                  "groundAnchorBLocalX": {
                    "type": "number"
                  },
                  "groundAnchorBLocalY": {
                    "type": "number"
                  },
                  "lengthAM": {
                    "type": "number"
                  },
                  "lengthBM": {
                    "type": "number"
                  },
                  "ratio": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "gear": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ratio": {
                    "type": "number"
                  },
                  "jointALocalId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "jointBLocalId": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "wheel": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "frequencyHz": {
                    "type": "number"
                  },
                  "dampingRatio": {
                    "type": "number"
                  },
                  "motorSpeedRad": {
                    "type": "number"
                  },
                  "maxMotorTorque": {
                    "type": "number"
                  },
                  "axisX": {
                    "type": "number"
                  },
                  "axisY": {
                    "type": "number"
                  },
                  "enableMotor": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "weld": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "referenceAngleRad": {
                    "type": "number"
                  },
                  "frequencyHz": {
                    "type": "number"
                  },
                  "dampingRatio": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "friction": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "maxForce": {
                    "type": "number"
                  },
                  "maxTorque": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "motor": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "linearOffsetX": {
                    "type": "number"
                  },
                  "linearOffsetY": {
                    "type": "number"
                  },
                  "angularOffsetRad": {
                    "type": "number"
                  },
                  "maxForce": {
                    "type": "number"
                  },
                  "maxTorque": {
                    "type": "number"
                  },
                  "correctionFactor": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "jointLocalId",
          "type",
          "bodyALocalEntityId",
          "bodyBLocalEntityId"
        ]
      },
      "default": []
    }
  },
  "required": [
    "schemaVersion",
    "rootSourceEntityId",
    "entities"
  ],
  "additionalProperties": false,
  "description": "A definition does not place an instance. The root has x=y=0 and zIndex=0; layerIndex is forbidden in entityIndex. Local member transforms and zIndex survive spawn. Cross-entity references and the unique root are validated semantically."
}
