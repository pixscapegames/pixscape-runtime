  "$defs": {
    "PixscapeIdentityComponent": {
      "type": "object",
      "properties": {
        "stableId": {
          "type": "integer",
          "default": -1
        },
        "name": {
          "type": "string",
          "default": "unnamed"
        }
      }
    },
    "LayerComponent": {
      "type": "object",
      "properties": {
        "layerIndex": {
          "type": "integer",
          "default": 0
        },
        "spatialEnabled": {
          "type": "boolean",
          "default": false
        }
      },
      "not": {
        "required": [
          "type"
        ]
      },
      "description": "Only scene Layer entities may carry this. The obsolete type field is forbidden."
    },
    "EntityIndexComponent": {
      "type": "object",
      "properties": {
        "layerIndex": {
          "type": "integer",
          "default": 0
        },
        "zIndex": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "LayerParallaxComponent": {
      "type": "object",
