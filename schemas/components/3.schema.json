        "rotationRad": {
          "type": "number",
          "default": 0
        },
        "scaleX": {
          "type": "number",
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "default": 1
        }
      }
    },
    "GameObjectComponent": {
      "type": "object",
      "properties": {
        "sourceAssetId": {
          "type": "string",
          "default": ""
