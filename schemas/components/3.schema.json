    "games.pixscape.runtime.component.spatial.SpatialShapesComponent": "SpatialShapesComponent",
    "games.pixscape.runtime.component.spatial.SpatialBlocksComponent": "SpatialBlocksComponent",
    "games.pixscape.runtime.component.light.PointLightComponent": "PointLightComponent",
    "games.pixscape.runtime.component.light.ConeLightComponent": "ConeLightComponent",
    "games.pixscape.runtime.component.ParticleEmitterComponent": "ParticleEmitterComponent",
    "games.pixscape.runtime.component.ParticleOverridesComponent": "ParticleOverridesComponent",
